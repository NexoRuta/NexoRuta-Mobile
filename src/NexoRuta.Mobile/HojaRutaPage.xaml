<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:NexoRuta.Mobile.Presentacion" xmlns:ui="clr-namespace:NexoRuta.Mobile.Controles" x:Class="NexoRuta.Mobile.HojaRutaPage" x:DataType="vm:HojaRutaViewModel" Title="Mi recorrido">
 <ContentPage.ToolbarItems><ToolbarItem Text="Actualizar" Command="{Binding Sincronizar}" /><ToolbarItem Text="Terminar jornada" Command="{Binding Finalizar}" Order="Secondary" /></ContentPage.ToolbarItems>
 <ui:OverlayCarga IsBusy="{Binding Ocupado}">
 <CollectionView ItemsSource="{Binding Paradas}" SelectionMode="Single" SelectionChanged="AbrirParada" Margin="20,0">
  <CollectionView.Header><VerticalStackLayout Spacing="16" Padding="0,12,0,20">
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="4"><Label Text="{Binding Hoja.Fecha, StringFormat='{0:dddd d MMMM}'}" Style="{StaticResource Caption}" /><Label Text="Hoja de ruta" Style="{StaticResource PageTitle}" /></VerticalStackLayout><Border Grid.Column="1" Padding="12,8" VerticalOptions="Center"><Label Text="{Binding Hoja.Matricula}" FontFamily="OpenSansSemibold" FontSize="13" /></Border></Grid>
   <Border Style="{StaticResource Card}"><Grid><VerticalStackLayout Spacing="14" Padding="0,0,32,0"><Label Text="{Binding Etapa}" Style="{StaticResource Eyebrow}" /><Label Text="{Binding Resumen}" FontFamily="OpenSansSemibold" FontSize="21" /><ProgressBar Progress="{Binding Progreso}" /><Label Text="{Binding EstadoInformativo}" Style="{StaticResource Caption}" HeightRequest="56" MaxLines="2" LineBreakMode="TailTruncation" /></VerticalStackLayout></Grid></Border>
   <Button Text="Iniciar jornada" Command="{Binding Iniciar}" IsVisible="{Binding MostrarInicio}" />
   <VerticalStackLayout IsVisible="{Binding MostrarCarga}" Spacing="12">
    <Label Text="{Binding ResumenCarga}" Style="{StaticResource SectionTitle}" /><Button Text="Escanear bulto" Command="{Binding Escanear}" ImageSource="ic_box.png" Style="{StaticResource SecondaryButton}" />
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Carga}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:BultoCargaResumen"><Grid ColumnDefinitions="*,Auto" Padding="4,9"><Label Text="{Binding Codigo}" FontSize="14" /><Label Grid.Column="1" Text="{Binding Estado}" Style="{StaticResource Caption}" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
    <Button Text="Comenzar reparto" Command="{Binding ConfirmarCarga}" />
   </VerticalStackLayout>
   <Border Padding="16"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="ic_pin.png" HeightRequest="24" WidthRequest="24" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Recorrido" FontFamily="OpenSansSemibold" /><Label Text="{Binding EstadoMapa}" Style="{StaticResource Caption}" /></VerticalStackLayout><Button Grid.Column="2" Text="Ver mapa" Clicked="PrepararMapa" Style="{StaticResource TextButton}" /></Grid></Border>
   <Button Text="Rendir bultos en depósito" Command="{Binding Rendir}" IsVisible="{Binding MostrarRendicion}" Style="{StaticResource SecondaryButton}" />
   <Grid ColumnDefinitions="*,Auto"><Label Text="Paradas" Style="{StaticResource SectionTitle}" /><Label Grid.Column="1" Text="{Binding CantidadParadas}" Style="{StaticResource Caption}" VerticalOptions="Center" /></Grid>
  </VerticalStackLayout></CollectionView.Header>
  <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:ParadaResumen"><Border Padding="16" Margin="0,0,0,12"><Grid ColumnDefinitions="38,*,20" ColumnSpacing="12">
   <Border WidthRequest="34" HeightRequest="34" Padding="0" StrokeThickness="0" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 10" VerticalOptions="Start"><Label Text="{Binding Orden}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
   <VerticalStackLayout Grid.Column="1" Spacing="7"><Label Text="{Binding Destinatario}" FontFamily="OpenSansSemibold" FontSize="18" /><Label Text="{Binding Direccion}" Style="{StaticResource Caption}" FontSize="14" /><HorizontalStackLayout Spacing="10"><Label Text="{Binding Bultos}" Style="{StaticResource Caption}" /><Label Text="{Binding EtiquetaEstado}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" /></HorizontalStackLayout></VerticalStackLayout>
   <Image Grid.Column="2" Source="ic_arrow.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
  </Grid></Border></DataTemplate></CollectionView.ItemTemplate>
  <CollectionView.Footer><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Footer>
 </CollectionView>
 </ui:OverlayCarga>
</ContentPage>
