<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:NexoRuta.Mobile.Presentacion" xmlns:r="clr-namespace:NexoRuta.Mobile.Core.Rutas;assembly=NexoRuta.Mobile.Core"
    x:Class="NexoRuta.Mobile.MainPage" x:DataType="vm:PrincipalViewModel" Title="Mi jornada">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4"><Label Text="NexoRuta" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="Repartidor" FontSize="16" /></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="{Binding Mensaje}" FontSize="16" SemanticProperties.Description="{Binding Mensaje}" />
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="2" IsVisible="{Binding MostrarIngreso}">
            <VerticalStackLayout Spacing="12">
                <Button Text="Desbloquear jornada guardada" Command="{Binding Desbloquear}" IsVisible="{Binding TieneCuenta}" />
                <Label Text="Ingresar con tu cuenta" FontSize="22" FontAttributes="Bold" />
                <Label Text="Correo electrónico" /><Entry Text="{Binding Email}" Keyboard="Email" ReturnType="Next" IsEnabled="{Binding ServicioConfigurado}" />
                <Label Text="Contraseña" /><Entry Text="{Binding Password}" IsPassword="True" ReturnType="Go" ReturnCommand="{Binding Ingresar}" IsEnabled="{Binding ServicioConfigurado}" />
                <Button Text="Ingresar" Command="{Binding Ingresar}" />
                <Label Text="Tu administrador crea y gestiona la cuenta." FontSize="14" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" IsVisible="{Binding Desbloqueada}" IsEnabled="{Binding PuedeOperar}">
            <HorizontalStackLayout Spacing="12"><DatePicker Date="{Binding Fecha}" /><Button Text="Descargar hoja" Command="{Binding Descargar}" /></HorizontalStackLayout>
            <Label Grid.Row="1" Text="Tus rutas guardadas" FontAttributes="Bold" FontSize="22" />
            <VerticalStackLayout Grid.Row="2" Spacing="6">
                <HorizontalStackLayout Spacing="12"><Button Text="Mis avisos" Clicked="AbrirAvisos" /><Button Text="Activar avisos" Command="{Binding ActivarAvisos}" /></HorizontalStackLayout>
                <Label Text="{Binding EstadoAvisos}" FontSize="14" />
                <Button Text="Volver a ingresar con mi cuenta" Command="{Binding Reingresar}" />
                <Button Text="Cerrar sesión / cambiar de cuenta" Command="{Binding CerrarSesion}" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="3" ItemsSource="{Binding Hojas}" SelectionMode="Single" SelectionChanged="AbrirHoja">
                <CollectionView.EmptyView><Label Text="Todavía no hay hojas descargadas." Padding="0,20" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate><DataTemplate x:DataType="r:HojaRuta">
                    <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12"><VerticalStackLayout Spacing="5">
                        <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding Matricula}" /><Label Text="{Binding Estado}" />
                        <Label Text="Abrir paradas →" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                    </VerticalStackLayout></Border>
                </DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
