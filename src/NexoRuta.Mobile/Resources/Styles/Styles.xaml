<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ui="clr-namespace:NexoRuta.Mobile.Presentacion">
 <ui:TieneTextoConverter x:Key="TieneTexto" />
 <ui:ColorEstadoConverter x:Key="ColorEstado" />
 <Style TargetType="Page" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}" /></Style>
 <Style TargetType="NavigationPage"><Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" /><Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" /><Setter Property="IconColor" Value="{StaticResource Primary}" /></Style>
 <Style x:Key="LabelBase" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=#E7EDF5}" /></Style>
 <Style x:Key="PageTitle" TargetType="Label" BasedOn="{StaticResource LabelBase}"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="28" /></Style>
 <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource LabelBase}"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="19" /></Style>
 <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource LabelBase}"><Setter Property="FontSize" Value="13" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" /></Style>
 <Style x:Key="Eyebrow" TargetType="Label" BasedOn="{StaticResource Caption}"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="CharacterSpacing" Value="1.5" /><Setter Property="FontSize" Value="11" /><Setter Property="TextColor" Value="{StaticResource Primary}" /></Style>
 <Style x:Key="BorderBase" TargetType="Border"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark=#304158}" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" /></Style>
 <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource BorderBase}"><Setter Property="Padding" Value="20" /></Style>
 <Style x:Key="Notice" TargetType="Border" BasedOn="{StaticResource BorderBase}"><Setter Property="Padding" Value="14" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark=#213653}" /><Setter Property="StrokeShape" Value="RoundRectangle 12" /></Style>
 <Style x:Key="ButtonBase" TargetType="Button"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="White" /><Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18,14" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="MinimumWidthRequest" Value="48" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.42" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
 <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark=#213653}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" /></Style>
 <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="Padding" Value="10,10" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="TextColor" Value="{StaticResource Danger}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark=#442B38}" /></Style>
 <Style TargetType="Entry"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" /><Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" /><Setter Property="BackgroundColor" Value="Transparent" /></Style>
 <Style x:Key="InputFrame" TargetType="Border" BasedOn="{StaticResource BorderBase}"><Setter Property="Padding" Value="12,0" /><Setter Property="StrokeShape" Value="RoundRectangle 10" /></Style>
 <Style TargetType="Picker"><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" /><Setter Property="TitleColor" Value="{StaticResource Gray500}" /></Style>
 <Style TargetType="DatePicker"><Setter Property="Format" Value="ddd d MMM" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" /></Style>
 <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{StaticResource Primary}" /></Style>
 <Style x:Key="LoadingScrim" TargetType="Grid"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LoadingScrimLight}, Dark={StaticResource LoadingScrimDark}}" /></Style>
 <Style x:Key="LoadingCard" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark=#40516B}" /></Style>
 <Style x:Key="LoadingIndicator" TargetType="ActivityIndicator"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" /></Style>
 <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{StaticResource Primary}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark=#304158}" /><Setter Property="HeightRequest" Value="5" /></Style>
 <Style TargetType="CheckBox"><Setter Property="Color" Value="{StaticResource Primary}" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" /></Style>
 <Style TargetType="Label" BasedOn="{StaticResource LabelBase}" />
 <Style TargetType="Border" BasedOn="{StaticResource BorderBase}" />
 <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
</ResourceDictionary>
